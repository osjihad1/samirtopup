# Copy to .env for LOCAL development only. NEVER commit .env. On Vercel set these in Project Settings -> Environment Variables.
MONGODB_URI=mongodb+srv://<user>:<password>@<your-cluster>.mongodb.net/samirtopup?retryWrites=true&w=majority
MONGODB_DB=samirtopup
# 32+ random chars each, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=
ADMIN_SECRET=
ADMIN_USERNAME=
# Long random password (16+ chars)
ADMIN_PASSWORD=
PORT=3000
